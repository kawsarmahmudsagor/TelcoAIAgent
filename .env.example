# ---- Postgres ----
# NOTE: default port is 5435, not 5432 — many dev machines already have a
# native Postgres service bound to 5432, which silently steals connections
# from anything Docker tries to forward on that same port (5433 is the
# RealEstateAgent project's, 5434 is taken here too). Change freely if
# 5435 is also taken, just keep POSTGRES_PORT and DATABASE_URL in sync.
POSTGRES_USER=telco
POSTGRES_PASSWORD=telco
POSTGRES_DB=telco
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+psycopg://telco:telco@localhost:5435/telco

# ---- LiveKit (self-hosted; `livekit-server --dev` defaults shown) ----
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=telco_agent

# ---- STT/TTS provider ----
# "elevenlabs" or "deepgram" -- selects which service app.agent.entrypoint wires
# up for speech-to-text and text-to-speech. Both providers' settings below stay
# configured side by side regardless of which one is active.
STT_TTS_PROVIDER=elevenlabs

# ---- ElevenLabs (used when STT_TTS_PROVIDER=elevenlabs) ----
# Where the ElevenLabs models come from:
#   free        the ElevenLabs API directly, with ELEVENLABS_API_KEYS below (default)
#   openrouter  the same models through OpenRouter, billed to OPENROUTER_API_KEY (or the
#               dashboard OpenRouter key); ELEVENLABS_API_KEYS is then unused.
#               Transcription is per turn, not realtime: ~1-2s slower to respond.
# Only the default: the dashboard (Chatbot > Model > Voice) offers ElevenLabs, ElevenLabs
# via OpenRouter and Deepgram, plus the voice model, and a saved choice there wins.
# The voice (ELEVENLABS_TTS_VOICE_ID / dashboard) is used in both. DEEPGRAM_API_KEY stays
# the last-resort fallback in both.
ELEVENLABS_PROVIDER=free
ELEVENLABS_OPENROUTER_TTS_MODEL=elevenlabs/eleven-v4-turbo
ELEVENLABS_OPENROUTER_STT_MODEL=elevenlabs/scribe-v2
# Comma-separated keys (e.g. one per free account), tried in order. When a key runs
# out of credits mid-call the agent switches to the next one; once every key is spent
# it falls back to Deepgram if DEEPGRAM_API_KEY is set (English Aura voice, so the
# voice changes mid-call and non-English callers get a weaker fallback).
# Before each call, keys with fewer than ELEVENLABS_MIN_REMAINING_CREDITS left are
# moved to the end of the list.
ELEVENLABS_API_KEYS=
ELEVENLABS_MIN_REMAINING_CREDITS=1000
# Legacy single key, tried after ELEVENLABS_API_KEYS. Leave it empty when using the list.
ELEVENLABS_API_KEY=changeme
# EXAVITQu4vr4xnSDxMaL = "Sarah", a premade female American-English voice confirmed
# API-usable on the ElevenLabs free tier (many "voice library" voices, incl. Rachel,
# are web-app-only on free tier and return 402 payment_required over the API).
ELEVENLABS_TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# TTS model. Both of these list Bengali (eleven_multilingual_v2 does not):
#   eleven_v4_turbo  low latency, built for voice agents (default)
#   eleven_v3        more expressive, roughly twice the time to first audio
# The agent synthesizes sentence by sentence over REST, so models without WebSocket
# streaming (eleven_v3) work too.
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Seconds of silence before a caller's turn is finalized (0.3-3). Lower replies faster;
# too low answers callers who pause mid-sentence.
ELEVENLABS_STT_SILENCE_SECS=0.8
# Batch STT (voice provider openrouter) only: seconds after the caller goes quiet
# before the turn may close, so a mid-sentence pause doesn't split the turn.
BATCH_STT_ENDPOINT_MIN_DELAY_S=2.0
DEFAULT_LANGUAGE=bn

# ---- Deepgram (used when STT_TTS_PROVIDER=deepgram) ----
DEEPGRAM_API_KEY=changeme
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# ---- LLM provider: gemini (default) or openrouter ----
LLM_PROVIDER=gemini

# ---- Gemini ----
GOOGLE_API_KEY=changeme
# NOTE: not gemini-flash-lite-latest -- that alias resolves to a Gemini-3-era
# model that requires thought_signature threading for function calls, but its
# name doesn't contain "gemini-3", so livekit-plugins-google's model-version
# detection misses it and every tool call 400s with "missing thought_signature".
# gemini-3.1-flash-lite is the same tier and gets detected correctly.
# NOTE: gemini-3.6-flash also works (it's a plain-text Gemini 3 model, and its
# name contains "gemini-3" so detection still applies) but its free tier caps
# at 20 requests/day per project -- easy to blow through in one voice call.
# gemini-3.1-flash-lite has a much higher free-tier daily limit.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- OpenRouter (used when LLM_PROVIDER=openrouter or ELEVENLABS_PROVIDER=openrouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# none | minimal | low | medium | high. Reasoning tokens delay the first spoken word;
# the dashboard can override it.
LLM_REASONING_EFFORT=minimal

# ---- Voice turn gate (browser calls) ----
# Ignores speech that isn't the customer talking to the agent (people in the room, TV,
# other languages, noise) and lets only the customer interrupt it. Uses the Jev relevance
# judge through OpenRouter, so it needs the OpenRouter key above. Phone calls are never gated.
TURN_GATE_ENABLED=false
TURN_JUDGE_MODEL=typesafe/jev-1.13
TURN_JUDGE_TIMEOUT_MS=1500
# Judge P(addressed): below DROP the turn is ignored silently (bystanders, TV, off-topic
# requests) and never reaches the LLM; while the agent talks, INTERRUPT or more cuts it off.
# Speech that paused the agent (TURN_PAUSE_*, at the customer's own level) needs only
# PAUSE_INTERRUPT to cut it off; speech over the agent that doesn't cut it off is dropped.
# Real turns score 0.39+ (scripts/judge_bench), people nearby 0.25-0.30.
TURN_DROP_P=0.3
TURN_INTERRUPT_P=0.4
TURN_PAUSE_INTERRUPT_P=0.35
TURN_INTERRUPT_MIN_WORDS=2
TURN_MIN_CONFIDENCE=0.4
TURN_OTHER_LANGUAGE_COOLDOWN_S=180
# Speech over the agent that is about as loud as the customer (within MARGIN_DB of their
# level, learned from their accepted turns; FALLBACK_DBFS before the first one) for
# MIN_SPEECH_S pauses it at once, so the customer doesn't have to talk over it while the
# judge decides. It then interrupts or resumes; a pause with no decision ends after
# RESUME_AFTER_S of quiet or MAX_S in all. Part of the gate: it needs TURN_GATE_ENABLED=true
# and the OpenRouter key, otherwise it does nothing and LiveKit's own interruption applies
# (any 0.5 s of voice, no loudness check).
TURN_PAUSE_ENABLED=true
TURN_PAUSE_MIN_SPEECH_S=0.3
TURN_PAUSE_MARGIN_DB=8
TURN_PAUSE_FALLBACK_DBFS=-35
TURN_PAUSE_RESUME_AFTER_S=3
TURN_PAUSE_MAX_S=8
# Turn router (needs the gate on and an OpenRouter LLM): Jev also says which lookup a
# turn needs and ROUTER_MODEL writes its arguments, so the search runs before the LLM
# and the LLM answers in one round trip instead of two. See scripts/router_bench.
ROUTER_ENABLED=true
ROUTER_MODEL=google/gemini-3.1-flash-lite
ROUTER_TIMEOUT_MS=1500
# Prefetch only when Jev is at least this sure which lookup the turn needs.
ROUTER_MIN_P=0.6
# Quick replies (needs the gate on and the OpenRouter key; switched on per agent in the
# dashboard): a small model answers turns that need no lookup, and speaks a short filler
# line while a lookup runs. QUICK_REPLY_MODEL is the default the dashboard can override.
QUICK_REPLY_MODEL=google/gemini-3.5-flash-lite
# The small model answers only when Jev is at least this sure no lookup is needed.
QUICK_ROUTE_MIN_P=0.7
# Give up on the filler model call after this long (a hung-connection safety).
# A filler is spoken whenever it is ready before the reply's first words.
FILLER_TIMEOUT_MS=10000
# The small model's first words must arrive within this, or the main model answers.
FAST_TIMEOUT_MS=1000
FAST_BUFFER_CHARS=24

# ---- Admin / auth ----
ADMIN_USERNAME=ceo
# bcrypt hash of the admin password (generate with: python -m app.scripts.hash_password "yourpassword")
ADMIN_PASSWORD_HASH=changeme
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
# Fernet key that encrypts secrets saved from the dashboard (e.g. the agent's LLM
# API key). Leave blank and saving a key from the dashboard is refused. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes saved keys unreadable (the agent then falls back to the
# env keys above) -- re-enter them in the dashboard.
SETTINGS_ENCRYPTION_KEY=

# ---- Knowledge base (RAG) ----
# Chroma vector-store server (run-local.bat starts the chromadb/chroma container
# on host port 8002; docker-compose overrides these to chroma:8000).
CHROMA_HOST=localhost
CHROMA_PORT=8002
# Where uploaded knowledge-base documents are stored. Blank = backend/storage/uploads.
UPLOAD_DIR=
# Embeddings go through OpenRouter: they use OPENROUTER_API_KEY above (or the key
# saved in the dashboard when OpenRouter is the LLM provider), even when the
# agent's LLM is Gemini. Without a key the knowledge base can't embed or search.
# With ELEVENLABS_PROVIDER=openrouter the same key also pays for speech.

# ---- Operator identity (used by the agent persona + mock invites) ----
OPERATOR_NAME=telco.
AGENT_DISPLAY_NAME=Anika
CEO_EMAIL=ceo@example.com
# Timezone the agent assumes for times customers say ("tomorrow at 3pm")
AGENCY_TIMEZONE=Asia/Dhaka

# ---- Real phone calls (Twilio Elastic SIP Trunk + livekit-sip) ----
# See docs/telephony-setup.md. Leave blank to keep browser-only cold calls.
# The LiveKit outbound trunk id (ST_...), from registering the trunk with LiveKit.
SIP_OUTBOUND_TRUNK_ID=
# Comma-separated E.164 numbers the bot may call (your own phones). Empty = none.
SIP_DIAL_ALLOWLIST=
SIP_RING_TIMEOUT_S=25
SIP_MAX_CALL_DURATION_S=600
# Twilio trunk details, for reference when registering the trunk; not read by the app:
TWILIO_PHONE_NUMBER=
TWILIO_SIP_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# run-local.bat switches: TELEPHONY=1 also starts redis + livekit-sip containers;
# SKIP_TUNNEL=1 skips the Cloudflare quick tunnel; CLOUDFLARE_TUNNEL_TOKEN runs a
# named tunnel instead (needs your own domain on Cloudflare).
TELEPHONY=0
SKIP_TUNNEL=0
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Backend/frontend wiring ----
# NOTE: default port is 8011, not 8000 — 8000 can end up with an orphaned
# listening socket at the OS level (seen on Windows via a WinNAT/Docker
# interaction) that survives killing every process bound to it and even a
# WinNAT service restart. 8010 is the RealEstateAgent project's. Change freely if 8011 is also taken, just run
# uvicorn with a matching --port and keep this in sync.
BACKEND_CORS_ORIGINS=http://localhost:3001
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8011
