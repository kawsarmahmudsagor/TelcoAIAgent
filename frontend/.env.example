# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=

# Backend FastAPI, used by the admin login/dashboard pages. By default the
# browser calls same-origin /backend/* and Next.js forwards it to
# FASTAPI_INTERNAL_URL -- that's what lets the Cloudflare tunnel serve the
# dashboard. Must match the port uvicorn actually runs on (8011, not 8000).
FASTAPI_INTERNAL_URL=http://localhost:8011
# Optional: make the browser call FastAPI directly instead (breaks the tunnel).
NEXT_PUBLIC_FASTAPI_URL=
